<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 (API 31) and higher. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
